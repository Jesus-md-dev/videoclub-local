# Ruta absoluta a la carpeta que contiene los vídeos a servir
VIDEOS_PATH=C:\Users\jesus\Videos

# Puerto en el que escucha el servidor
PORT=3000

# Opcional: carpeta para los vídeos convertidos (pipeline antiguo, solo se
# usa ya para "Reproducir sin convertir") y para los paquetes HLS (el
# reproductor normal). Por defecto viven dentro de data/ (local a esta
# máquina); si el disco de vídeos es externo, apuntarlas ahí hace que
# viajen con él al cambiar de PC/servidor en vez de tener que regenerarlas.
# TRANSCODED_PATH=D:\VideoclubTranscoded
# HLS_PATH=D:\VideoclubHLS

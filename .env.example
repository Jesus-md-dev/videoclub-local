# Ruta absoluta a la carpeta que contiene los vídeos a servir
VIDEOS_PATH=C:\Users\jesus\Videos

# Puerto en el que escucha el servidor
PORT=3000

# Opcional: API key (v3) de TMDb (themoviedb.org/settings/api) para
# categorías/géneros automáticos. Sin ella, la app funciona igual pero
# sin filtros por género.
TMDB_API_KEY=

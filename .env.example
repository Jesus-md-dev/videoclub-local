# Ruta absoluta a la carpeta que contiene los vídeos a servir
VIDEOS_PATH=C:\Users\jesus\Videos

# Puerto en el que escucha el servidor
PORT=3000

# Opcional: carpeta para los paquetes HLS (el reproductor normal). Por
# defecto vive dentro de data/ (local a esta máquina); si el disco de
# vídeos es externo, apuntarla ahí hace que viaje con él al cambiar de
# PC/servidor en vez de tener que regenerarla.
# HLS_PATH=D:\VideoclubHLS
